{
  // 使用 IntelliSense 了解相关属性。
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "tsx",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": [
        "${file}"
      ],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "启动程序",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "runtimeExecutable": "node",
      "program": "${file}"
    },
    {
      "type": "msedge",
      "name": " http://localhost:5173/",
      "request": "launch",
      "url": " http://localhost:5173/"
    },
    {
      "name": "Debug Swift (TSPL)",
      "type": "lldb",
      "request": "launch",
      // 用 swiftc 一次编译 Sources/TSPL 下所有文件（main.swift 为入口）。
      // 没用 swift build：当前 CommandLineTools 的 SwiftPM manifest 已损坏。
      // 也不能直接调试 swift 解释器：xcrun/swift 是 Apple 签名的系统二进制，
      // SIP 禁止 debugserver 附加，会报 Not allowed to attach to process。
      "initCommands": [
        "platform shell mkdir -p '${workspaceFolder}/.build' && swiftc -g -Onone -swift-version 6 -o '${workspaceFolder}/.build/TSPL' '${workspaceFolder}/books/The Swift Programming Language/Sources/TSPL/'*.swift"
      ],
      "program": "${workspaceFolder}/.build/TSPL",
      "args": [],
      "cwd": "${workspaceFolder}/books/The Swift Programming Language",
      "terminal": "integrated",
      "stopOnEntry": false
    }
  ]
}