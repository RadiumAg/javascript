{
  // 使用 IntelliSense 了解相关属性。
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug .ts (tsx)",
      "type": "node",
      "request": "launch",
      // 注意：必须配合 tsx@4.22.4 使用。4.23+ 的 CLI 会派生子进程，
      // 导致 VS Code 调试器附加双进程后死锁卡死（已在 renovate.json 中锁定禁止升级）。
      // 只用于 .ts/.tsx：.js 会走 tsx 的 CJS 同步钩子，esbuild 同步转换的 worker
      // 线程与 js-debug 互等死锁，.js 请用 "Debug .js (node)"
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "args": [
        "${file}"
      ],
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ]
    },
    {
      "name": "Debug ES2025 (node24 tsx)",
      "type": "node",
      "request": "launch",
      // ES2025 Iterator helper 等 API 需 Node 23+，nvm 默认是 20.19.4，
      // 这里钉死 v24.14.1 绝对路径（裸 "node" 在 GUI 环境会找不到）
      "runtimeExecutable": "/Users/zly/.nvm/versions/node/v24.14.1/bin/node",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "args": [
        "${file}"
      ],
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      // 纯 node 直跑，用于 .js（含 ESM/CJS）。.ts/.tsx 请选 "Debug .ts (tsx)"
      "name": "Debug .js (node)",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "runtimeExecutable": "node",
      "program": "${file}"
    },
    {
      "type": "msedge",
      "name": " http://localhost:5173/",
      "request": "launch",
      "url": " http://localhost:5173/"
    },
    {
      "name": "Debug Swift (TSPL)",
      "type": "lldb",
      "request": "launch",
      "initCommands": [
        "platform shell mkdir -p '${workspaceFolder}/.build' && swiftc -g -Onone -swift-version 6 -o '${workspaceFolder}/.build/TSPL' '${workspaceFolder}/books/The Swift Programming Language/Sources/TSPL/'*.swift"
      ],
      "program": "${workspaceFolder}/.build/TSPL",
      "args": [],
      "cwd": "${workspaceFolder}/books/The Swift Programming Language",
      "terminal": "integrated",
      "stopOnEntry": false
    },
    {
      "type": "swift",
      "request": "launch",
      "args": [],
      "cwd": "${workspaceFolder:javascript}/books/The Swift Programming Language",
      "name": "Debug TSPL (books/The Swift Programming Language)",
      "target": "TSPL",
      "configuration": "debug",
      "preLaunchTask": "swift: Build Debug TSPL (books/The Swift Programming Language)"
    },
    {
      "type": "swift",
      "request": "launch",
      "args": [],
      "cwd": "${workspaceFolder:javascript}/books/The Swift Programming Language",
      "name": "Release TSPL (books/The Swift Programming Language)",
      "target": "TSPL",
      "configuration": "release",
      "preLaunchTask": "swift: Build Release TSPL (books/The Swift Programming Language)"
    }
  ]
}