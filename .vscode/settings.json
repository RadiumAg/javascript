{
  "liveServer.settings.port": 5502,
  "[python]": {
    "editor.defaultFormatter": "ms-python.autopep8",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[swift]": {
    "editor.defaultFormatter": "vknabel.vscode-apple-swift-format",
    "editor.formatOnSave": true
  },
  // swift-format 不在 PATH 上，只能通过 xcrun 从工具链里定位
  "apple-swift-format.path": [
    "/usr/bin/xcrun",
    "swift-format"
  ],
  // Package.swift 不在工作区根目录，必须开启子目录搜索，SourceKit-LSP 才能识别
  "swift.searchSubfoldersForPackages": true,
  "typescript.tsdk": "node_modules\\typescript\\lib",
  "compile-hero.disable-compile-files-on-did-save-code": true,
  "i18next.i18nPaths": "/Users/agradium/Desktop/work/javascript/books/react通关秘籍/calendar-component/src/components/calendar/locale",
  "git.autoRepositoryDetection": "openEditors",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true
  }
}